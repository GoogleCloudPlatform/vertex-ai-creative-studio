# Required: Your Google Cloud Project ID for Vertex AI
GOOGLE_CLOUD_PROJECT=your-project-id
# Region for the Veo (video generation) endpoint.
GOOGLE_CLOUD_LOCATION=us-central1
# Location for the Gemini text models and the Nano Banana (Gemini) image model.
# The Gemini 3.x family is served only from the "global" endpoint; leave as-is
# unless you know these models are available in a specific region.
GEMINI_LOCATION=global
