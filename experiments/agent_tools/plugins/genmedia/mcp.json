{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nanobanana": {
      "type": "stdio",
      "command": "./bin/genmedia-launch",
      "args": ["mcp-nanobanana-go", "--transport", "stdio"],
      "env": {
        "GENMEDIA_RELEASE_TAG": "v3.18.0",
        "GENMEDIA_CACHE": "${PLUGIN_DATA}/bin"
      },
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
